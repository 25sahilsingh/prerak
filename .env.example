# Each visitor connects their own model in Settings; it is kept in their browser, never on the server.
# Optional: a default model for visitors who have not connected one. Leave LLM_BASE_URL empty for none.
# This address and key stay on the server and are never sent to a visitor's model address.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Whether visitor model addresses may point at localhost or private networks (10.x, 192.168.x, ...).
# Unset means: allowed under `npm run dev`, refused under `npm start`. Keep it refused on a public server.
ALLOW_PRIVATE_MODEL_URLS=

# Optional. Used only by `npm run upload:pdf` on your machine. Leave blank in git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password for /admin. Set this only in .env.local.
ADMIN_PASSWORD=
